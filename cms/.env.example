# SQLite file (local / single server). For Postgres, switch the adapter in src/payload.config.ts.
DATABASE_URL=file:./cms.db
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public URL of this CMS, and of the site (for "preview" links and CORS)
CMS_URL=http://localhost:3100
SITE_URL=http://localhost:4321

# The site's public/ folder, to read motion packages (frame counts, landmarks). Default ../public
# SITE_PUBLIC_DIR=../public

# Rebuild the static site after content changes (either or both; see src/hooks/rebuild.ts)
# SITE_REBUILD_URL=https://api.example.com/deploy-hook
# SITE_REBUILD_COMMAND=npm --prefix .. run build:strict
# SITE_REBUILD_DELAY=8000
