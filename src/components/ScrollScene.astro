---
// A pinned, full-screen scene whose image sequence scrubs with page scroll
// (after malinowskiego.com). Used for Kawasan and Cluster on the homepage.
//
// With `hero`, the scene opens as the hero banner over a looping video of the
// same orbit; on the first scroll the canvas takes over at the frame the video is
// showing, and the hero text gives way to the section panel without a break.
// Without `hero`, the panel and markers show from the start.
//
// Opening a hotspot (marker or list) fast-forwards the orbit to the hotspot's
// default angle while zooming in on it, with its info in place of the section
// panel. Back, Esc, or scrolling on returns to the orbit.
//
// Logic in src/scripts/scroll-scene.js.
import { site, url } from '../data/site.js';

interface Hotspot {
  track: string;
  frame?: number; // default angle: frame of the scene to turn to when opened
  title: string;
  short?: string;
  text: string;
}

interface Props {
  id: string;
  title: string;
  intro: string;
  scene: { base: string; startFrame?: number; placeholder?: boolean };
  hotspots: Record<string, Hotspot>;
  hero?: { eyebrow: string; title: string; teaser: string; full: string; cover: string };
}

const { id, title, intro, scene, hotspots, hero } = Astro.props;
const spots = Object.entries(hotspots).map(([key, h]) => ({
  key,
  short: h.short || h.title,
  content: { track: h.track, frame: h.frame, title: h.title, text: h.text },
}));
const fullPayload = hero && JSON.stringify({ src: url(hero.full), title: site.fullName });
---

<section
  class:list={['scene', { 'scene--hero': hero }]}
  data-scene
  data-base={url(scene.base)}
  data-start={scene.startFrame ?? 0}
  data-spots={JSON.stringify(Object.fromEntries(spots.map((s) => [s.key, s.content])))}
  aria-labelledby={`${id}-title`}
>
  <span id={id} class="scene__anchor" aria-hidden="true"></span>

  <div class="scene__stage">
    {
      hero && (
        <video
          class="scene__media scene__video"
          muted
          loop
          playsinline
          preload="auto"
          poster={url(hero.cover)}
          data-src={url(hero.teaser)}
          aria-hidden="true"
        />
      )
    }
    <canvas class="scene__media scene__canvas" aria-hidden="true"></canvas>
    <div class="scene__shade" aria-hidden="true"></div>

    <div class="scene__markers">
      {
        spots.map((s, i) => (
          <button class="spot" type="button" data-spot={s.key} tabindex="-1" hidden>
            <span class="spot__dot">{i + 1}</span>
            <span class="spot__label">{s.short}</span>
          </button>
        ))
      }
    </div>

    {
      site.showPlaceholderBadges && scene.placeholder && (
        <span class="badge scene__badge" data-phase="area">
          Sekuens contoh
        </span>
      )
    }

    {
      hero && (
        <>
          <div class="scene__hero wrap" data-phase="hero">
            <p class="eyebrow scene__eyebrow">{hero.eyebrow}</p>
            <h1 class="display scene__title">{hero.title}</h1>
            <button class="scene__play" type="button" data-open="video" data-payload={fullPayload}>
              <span class="scene__play-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
                </svg>
              </span>
              <span class="scene__play-label">Play Full Video</span>
            </button>
          </div>
          <p class="scene__cue eyebrow" data-phase="hero" aria-hidden="true">
            Gulir
          </p>
        </>
      )
    }

    <div class="scene__area wrap" data-phase="area">
      <h2 class="display scene__area-title" id={`${id}-title`}>{title}</h2>
      <p class="scene__intro">{intro}</p>
      <ol class="scene__list">
        {
          spots.map((s, i) => (
            <li>
              <button type="button" data-spot-open={s.key}>
                <span>{String(i + 1).padStart(2, '0')}</span>
                {s.content.title}
              </button>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Location view: shown in place of the panel while a hotspot is open -->
    <div class="scene__loc wrap" role="group" aria-labelledby={`${id}-loc-title`} hidden>
      <button class="scene__back" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M19 12H5M11 6l-6 6 6 6"></path>
        </svg>
        Kembali ke {title.toLowerCase()}
      </button>
      <h3 class="display scene__loc-title" id={`${id}-loc-title`} tabindex="-1"></h3>
      <p class="scene__loc-text"></p>
      <div class="scene__loc-nav">
        <button class="icon-btn" type="button" data-loc-step="-1" aria-label="Lokasi sebelumnya">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 5l-7 7 7 7"></path></svg>
        </button>
        <button class="icon-btn" type="button" data-loc-step="1" aria-label="Lokasi berikutnya">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>

    <div class="scene__meter" data-phase="area" aria-hidden="true">
      <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="17"></circle><path class="scene__needle" d="M20 20 L20 5"></path></svg>
      <span class="scene__deg">0°</span>
      <span class="scene__bar"><span></span></span>
    </div>
  </div>
</section>

<style>
  .scene {
    --range: 400vh; /* scroll distance for one full orbit */
    position: relative;
    height: calc(100vh + var(--range));
    height: calc(100svh + var(--range));
    background: var(--room);
    color: #fff;
  }

  @media (max-width: 760px) {
    .scene {
      --range: 300vh;
    }
  }

  /* The page's scroll-padding stops links one header height above their target,
     so push the anchor down by that much: section links land exactly on the
     pinned view (the header is transparent over scenes). */
  .scene__anchor {
    position: absolute;
    top: var(--header-h);
  }

  /* With a hero, the section link lands where the panel has faded in. */
  .scene--hero .scene__anchor {
    top: calc(var(--range) * 0.18 + var(--header-h));
  }

  .scene__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .scene__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scene__video {
    object-fit: cover;
  }

  .scene__canvas {
    opacity: 0;
  }

  .scene.is-scrub .scene__canvas {
    opacity: 1;
  }

  /* ---- go to a location: the camera is drawn inside the canvas by
     scroll-scene.js, so nothing to style here. */

  /* Orbit UI steps aside while a location is open. */
  .scene.is-flying [data-phase],
  .scene.is-flying .scene__markers {
    transition: opacity 0.4s ease;
  }

  .scene.is-place [data-phase],
  .scene.is-place .scene__markers {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  .scene__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(10, 10, 8, 0.55) 0%, rgba(10, 10, 8, 0) 26%),
      linear-gradient(0deg, rgba(10, 10, 8, 0.8) 0%, rgba(10, 10, 8, 0.12) 52%);
  }

  /* Extra shade behind the section panel, faded in with it. */
  .scene__shade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10, 10, 8, 0.6) 0%, rgba(10, 10, 8, 0.25) 38%, rgba(10, 10, 8, 0) 60%);
    opacity: var(--p-area, 0);
  }

  @media (max-width: 760px) {
    .scene__shade::after {
      background: linear-gradient(0deg, rgba(10, 10, 8, 0.7) 0%, rgba(10, 10, 8, 0) 60%);
    }
  }

  .scene__badge {
    position: absolute;
    top: calc(var(--header-h) + 12px + env(safe-area-inset-top, 0px));
    left: var(--gutter);
  }

  /* Phases fade by scroll; scroll-scene.js sets --p-hero / --p-area (0..1). */
  [data-phase='hero'] {
    opacity: var(--p-hero, 1);
    transform: translateY(calc((1 - var(--p-hero, 1)) * -40px));
    visibility: var(--v-hero, visible);
  }

  [data-phase='area'] {
    opacity: var(--p-area, 0);
    transform: translateY(calc((1 - var(--p-area, 0)) * 40px));
    visibility: var(--v-area, hidden);
  }

  /* ---- hero */
  .scene__hero {
    position: absolute;
    inset: auto 0 0;
    padding-bottom: clamp(56px, 10vh, 112px);
  }

  .scene__eyebrow {
    margin: 0 0 20px;
    color: #f0c9a4;
    animation: rise 1s 0.2s var(--ease) both;
  }

  .scene__title {
    margin: 0;
    max-width: 13ch;
    font-size: clamp(52px, 9vw, 136px);
    animation: rise 1.1s 0.35s var(--ease) both;
  }

  .scene__play {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: clamp(28px, 4vw, 44px);
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    animation: rise 1s 0.6s var(--ease) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .scene__play-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.7);
    transition: background 0.3s var(--ease), color 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .scene__play-icon svg {
    width: 22px;
    height: 22px;
    margin-left: 3px;
  }

  .scene__play-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .scene__play:hover .scene__play-icon {
    background: #fff;
    color: var(--ink);
    transform: scale(1.06);
  }

  .scene__cue {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(56px, 10vh, 112px);
    margin: 0;
    writing-mode: vertical-rl;
    color: rgba(255, 255, 255, 0.75);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .scene__cue::after {
    content: '';
    width: 1px;
    height: 56px;
    background: currentColor;
    transform-origin: top;
    animation: drip 2.2s var(--ease) infinite;
  }

  @keyframes drip {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  /* ---- section panel */
  .scene__area {
    position: absolute;
    inset: auto 0 0;
    padding-bottom: clamp(40px, 8vh, 96px);
    pointer-events: none;
  }

  .scene__area > * {
    max-width: 460px;
  }


  .scene__area-title {
    margin: 0 0 12px;
    font-size: clamp(56px, 8vw, 112px);
  }

  .scene__intro {
    margin: 0 0 20px;
    color: rgba(255, 255, 255, 0.78);
  }

  .scene__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    pointer-events: auto;
  }

  .scene__list button {
    width: 100%;
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    background: none;
    color: #fff;
    text-align: left;
    font-size: 15px;
    transition: color 0.2s, padding 0.3s var(--ease);
  }

  .scene__list button span {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #f0c9a4;
  }

  .scene__list button:hover {
    color: #f0c9a4;
    padding-left: 6px;
  }

  .scene__meter {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(40px, 8vh, 96px);
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .scene__meter svg {
    width: 34px;
    height: 34px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
  }

  .scene__needle {
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    transform-origin: 20px 20px;
    transform: rotate(var(--deg, 0deg));
  }

  .scene__deg {
    min-width: 4ch;
  }

  .scene__bar {
    width: 120px;
    height: 1px;
    background: rgba(255, 255, 255, 0.3);
  }

  .scene__bar span {
    display: block;
    height: 100%;
    width: calc(var(--progress, 0) * 100%);
    background: #fff;
  }

  /* ---- location panel */
  .scene__loc {
    position: absolute;
    inset: auto 0 0;
    padding-bottom: clamp(40px, 8vh, 96px);
    animation: loc-in 0.7s var(--ease) 0.15s both;
  }

  .scene__loc > * {
    max-width: 520px;
  }

  @keyframes loc-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .scene__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
    padding: 8px 16px 8px 12px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 999px;
    background: rgba(18, 18, 15, 0.35);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    backdrop-filter: blur(6px);
    transition: background 0.2s, color 0.2s;
  }

  .scene__back svg {
    width: 18px;
    height: 18px;
  }

  .scene__back:hover {
    background: #fff;
    color: var(--ink);
  }


  .scene__loc-title {
    margin: 0 0 14px;
    font-size: clamp(44px, 6.5vw, 96px);
    outline: none;
  }

  .scene__loc-text {
    margin: 0;
    font-size: 17px;
    color: rgba(255, 255, 255, 0.85);
  }

  .scene__loc-nav {
    display: flex;
    gap: 10px;
    margin-top: 24px;
  }

  .scene__loc-nav .icon-btn {
    color: #fff;
    background: rgba(18, 18, 15, 0.35);
    backdrop-filter: blur(6px);
  }

  .scene__loc-nav .icon-btn:hover {
    background: #fff;
    color: var(--ink);
  }

  /* ---- hotspot markers */
  .scene__markers {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--p-area, 0);
  }

  .spot {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    pointer-events: auto;
    will-change: transform;
  }

  .spot__dot {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border-radius: 50%;
    background: rgba(18, 18, 15, 0.5);
    border: 1.5px solid #fff;
    font-size: 12px;
    font-weight: 700;
    backdrop-filter: blur(4px);
    transition: background 0.2s, color 0.2s, transform 0.3s var(--ease);
  }

  .spot__dot::after {
    content: '';
    position: absolute;
    inset: -1.5px;
    border-radius: 50%;
    border: 1.5px solid #fff;
    animation: spot-ping 2.4s var(--ease) infinite;
  }

  @keyframes spot-ping {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(1.9);
      opacity: 0;
    }
  }

  .spot__label {
    margin-top: -17px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(18, 18, 15, 0.55);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    backdrop-filter: blur(4px);
  }

  .spot--flip {
    flex-direction: row-reverse;
  }

  .spot--flip .spot__dot {
    margin: -17px -17px 0 0;
  }

  .spot:hover .spot__dot,
  .spot:focus-visible .spot__dot {
    background: #fff;
    color: var(--ink);
    transform: scale(1.1);
  }

  @media (max-width: 760px) {
    .spot__label {
      display: none;
    }
    .scene__meter .scene__bar {
      display: none;
    }
    .scene__meter {
      bottom: auto;
      top: calc(var(--header-h) + 16px + env(safe-area-inset-top, 0px));
    }
    .scene__list button {
      padding: 8px 0;
      font-size: 14px;
    }
  }

  @media (max-width: 760px) and (max-height: 700px) {
    .scene__intro {
      display: none;
    }
  }
</style>

<script>
  import '../scripts/scroll-scene.js';
</script>
