---
// Unit types: 3 cards per row, at most 2 rows. Each card links to /tipe/<slug>/.
import SheetHeader from '../SheetHeader.astro';
import { types } from '../../data/types.js';
import { site, url } from '../../data/site.js';
---

<section id="tipe" class="types" aria-labelledby="tipe-title">
  <div class="wrap">
    <SheetHeader
      id="tipe-title"
      title="Pilih tipe"
      intro="Bandingkan luas tanah, luas bangunan, dan jumlah kamar. Buka satu tipe untuk menjelajahi fasad dan setiap lantainya."
    />

    <ul class="types__grid">
      {
        types.map((t, i) => (
          <li data-reveal style={`transition-delay: ${(i % 3) * 90}ms`}>
            <a class="card" href={url(`/tipe/${t.slug}/`)}>
              <div class="card__img">
                <img src={url(t.image)} alt={`${t.name}${t.label ? `, ${t.label}` : ''}`} loading="lazy" />
                <span class="card__open" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 17L17 7M9 7h8v8" /></svg>
                </span>
                {site.showPlaceholderBadges && t.placeholder && <span class="badge card__badge">Data contoh</span>}
              </div>
              <div class="card__head">
                <h3 class="card__name display">{t.name}</h3>
                {t.label && <span class="card__label eyebrow">{t.label}</span>}
              </div>
              <dl class="card__specs">
                <div><dt>LT</dt><dd>{t.lt} m²</dd></div>
                <div><dt>LB</dt><dd>{t.lb} m²</dd></div>
                <div><dt>K. tidur</dt><dd>{t.bedrooms}</dd></div>
                <div><dt>K. mandi</dt><dd>{t.bathrooms}</dd></div>
              </dl>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .types {
    padding-bottom: clamp(64px, 9vw, 120px);
    border-top: 1px solid var(--rule);
  }

  .types__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 56px) clamp(16px, 2.4vw, 32px);
  }

  @media (max-width: 960px) {
    .types__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .types__grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    display: block;
    text-decoration: none;
  }

  .card__img {
    position: relative;
    aspect-ratio: 6 / 5;
    background: #000;
    overflow: hidden;
  }

  .card__img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 1s var(--ease);
  }

  .card:hover .card__img img {
    transform: scale(1.05);
  }

  .card__open {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: var(--accent);
    color: #fff;
    transform: translateY(8px);
    opacity: 0;
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease), background 0.3s;
  }

  .card__open svg {
    width: 18px;
    height: 18px;
  }

  .card:hover .card__open,
  .card:focus-visible .card__open {
    opacity: 1;
    transform: none;
  }

  .card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
  }

  .card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 0 12px;
    border-bottom: 1px solid var(--ink);
  }

  .card__name {
    margin: 0;
    font-size: clamp(28px, 2.6vw, 36px);
  }

  .card__label {
    color: var(--accent);
  }

  .card__specs {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: space-between;
    gap: 8px;
    margin: 0;
    padding-top: 12px;
  }

  .card__specs dt {
    font-family: var(--label);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card__specs dd {
    margin: 2px 0 0;
    font-size: 16px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
</style>
