---
import { nav, site, url } from '../data/site.js';

interface Props {
  // 'home': transparent over the hero, section links.
  // 'type': solid, with a back link to the Unit update section.
  variant?: 'home' | 'type';
}

const { variant = 'home' } = Astro.props;
const home = url('/');
---

<header class={`hd hd--${variant}`} data-header>
  <div class="hd__inner wrap">
    <a class="hd__mark" href={home} aria-label={`${site.fullName} — beranda`}>
      <span class="hd__logo display">{site.name}</span>
      <span class="hd__name eyebrow">{site.fullName.replace(site.name, '').trim()}</span>
    </a>

    {
      variant === 'home' ? (
        <nav class="hd__nav" aria-label="Bagian halaman">
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      ) : (
        <a class="hd__back" href={`${home}#unit-update`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M19 12H5M11 6l-6 6 6 6" />
          </svg>
          Kembali ke Unit Update
        </a>
      )
    }
  </div>
</header>

<style>
  .hd {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    color: #fff;
    transition: background 0.35s var(--ease), color 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .hd.is-solid,
  .hd--type {
    background: rgba(239, 233, 223, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--ink);
    box-shadow: 0 1px 0 var(--rule);
  }

  .hd__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .hd__mark {
    display: flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
  }

  .hd__logo {
    font-size: 32px;
    line-height: 1;
  }

  .hd__nav {
    display: flex;
    gap: clamp(14px, 2.2vw, 32px);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hd__nav::-webkit-scrollbar {
    display: none;
  }

  .hd__nav a,
  .hd__back {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
    padding-block: 8px;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.3s var(--ease);
  }

  .hd__nav a:hover,
  .hd__back:hover {
    background-size: 100% 1px;
  }

  .hd__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .hd__back svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 860px) {
    .hd__name {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hd--home .hd__nav {
      display: none;
    }
    .hd__back {
      font-size: 12px;
    }
  }
</style>

<script>
  // Home: transparent while a pinned full-screen scene is behind it, solid otherwise.
  const header = document.querySelector('[data-header]');
  if (header?.classList.contains('hd--home')) {
    const scenes = [...document.querySelectorAll('[data-scene]')];
    const onScroll = () => {
      const h = header.offsetHeight;
      const over = scenes.some((s) => {
        const r = s.getBoundingClientRect();
        return r.top <= 1 && r.bottom > h;
      });
      header.classList.toggle('is-solid', !over);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
