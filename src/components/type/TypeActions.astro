---
// Gallery and VR buttons on a type page (panel and phone dock). Each hides when
// the type has no gallery images / no VR URL; VR opens over the page or in a new tab.
import { labels, url } from '../../data/site.js';

interface Props {
  galleryPayload: string;
  hasGallery: boolean;
  vrUrl?: string;
  vrPayload?: string;
  vrTab: boolean;
}

const { galleryPayload, hasGallery, vrUrl, vrPayload, vrTab } = Astro.props;
const tp = labels.typePage;
---

{hasGallery && <button class="btn" type="button" data-open="gallery" data-payload={galleryPayload}>{tp.galleryButton}</button>}
{
  vrUrl &&
    (vrTab ? (
      <a class="btn btn--solid" href={url(vrUrl)} target="_blank" rel="noopener">{tp.vrButton}</a>
    ) : (
      <button class="btn btn--solid" type="button" data-open="iframe" data-payload={vrPayload}>{tp.vrButton}</button>
    ))
}
