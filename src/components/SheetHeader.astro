---
// Section heading: title and intro.
interface Props {
  id?: string;
  title: string;
  intro?: string;
}

const { id, title, intro } = Astro.props;
---

<div class="sheet" data-reveal>
  <div>
    <h2 class="sheet__title display" id={id}>{title}</h2>
  </div>
  {intro && <p class="sheet__intro">{intro}</p>}
</div>
