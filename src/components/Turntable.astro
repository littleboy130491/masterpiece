---
// A WebRotate 360 turntable. Rotates on horizontal drag, horizontal wheel /
// trackpad swipe, the arrow buttons, or ←/→ when focused. Vertical scroll over
// the viewer keeps scrolling the page.
//
// `hotspots` (cluster only) maps WebRotate hotspot ids to the content of
// the info panel. The list under the viewer opens the same panels, so hotspots are
// reachable by keyboard and screen readers too.
import { site, url } from '../data/site.js';

interface Hotspot {
  title: string;
  text: string;
  image?: string;
}

interface Props {
  id: string;
  label: string;
  turntable: { package: string; width: number; height: number; firstImage?: number; poster?: string; placeholder?: boolean };
  hotspots?: Record<string, Hotspot>;
  kicker?: string;
  tone?: 'dark' | 'black';
}

const { id, label, turntable, hotspots = {}, kicker = label, tone = 'dark' } = Astro.props;
const resolved = Object.fromEntries(
  Object.entries(hotspots).map(([key, h]) => [key, { ...h, kicker, image: h.image && url(h.image) }]),
);
const pkg = url(turntable.package);
---

<div
  class={`tt tt--${tone}`}
  style={`--native: ${turntable.width}px`}
  data-turntable
  data-hotspots={JSON.stringify(resolved)}
>
  <div
    class="tt__stage"
    style={`aspect-ratio: ${turntable.width} / ${turntable.height}`}
    data-config={`${pkg}config.xml`}
    data-root={pkg}
    data-width={turntable.width}
    data-height={turntable.height}
    data-first={turntable.firstImage ?? 0}
  >
    {turntable.poster && <img class="tt__poster" src={url(turntable.poster)} alt="" loading="lazy" />}
    <div
      class="tt__viewer"
      id={id}
      tabindex="0"
      role="application"
      aria-roledescription="360° viewer"
      aria-label={`${label}, tampilan 360°. Gunakan panah kiri dan kanan untuk memutar.`}
    >
    </div>
    <div class="tt__loading" aria-hidden="true"><span></span></div>
    <p class="tt__locked">
      Tampilan 360° ini aktif setelah lisensi WebRotate 360 PRO dipasang. Versi gratis hanya memuat satu viewer per halaman.
    </p>
    {site.showPlaceholderBadges && turntable.placeholder && <span class="badge tt__badge">Sekuens contoh</span>}
  </div>

  <div class="tt__hud">
    <button class="icon-btn tt__step" type="button" data-step="-1" aria-label="Putar ke kiri" aria-controls={id}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <div class="tt__dial" aria-hidden="true">
      <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="17" /><path class="tt__needle" d="M20 20 L20 5" /></svg>
      <span class="tt__deg">0°</span>
    </div>
    <p class="tt__hint eyebrow">Geser untuk memutar</p>
    <button class="icon-btn tt__step" type="button" data-step="1" aria-label="Putar ke kanan" aria-controls={id}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>

  {
    Object.keys(resolved).length > 0 && (
      <ol class="tt__spots">
        {Object.entries(resolved).map(([key, h], i) => (
          <li>
            <button type="button" data-spot={key}>
              <span class="tt__spot-no">{String(i + 1).padStart(2, '0')}</span>
              {h.title}
            </button>
          </li>
        ))}
      </ol>
    )
  }
</div>

<style is:global>
  .tt {
    --tt-bg: var(--room-2);
    color: var(--room-ink);
    /* WebRotate never upscales frames past their native width. */
    max-width: var(--native);
    margin-inline: auto;
  }

  .tt--black {
    --tt-bg: #000;
  }

  .tt__stage {
    position: relative;
    width: 100%;
    background: var(--tt-bg);
    overflow: hidden;
    border-radius: 4px;
  }

  .tt__poster,
  .tt__viewer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .tt__poster {
    object-fit: cover;
    transition: opacity 0.4s var(--ease);
  }

  .tt.is-ready .tt__poster {
    opacity: 0;
  }

  .tt__viewer {
    cursor: grab;
    touch-action: pan-y;
  }

  .tt__viewer:active {
    cursor: grabbing;
  }

  .tt__viewer:focus-visible {
    outline-offset: -3px;
  }

  /* WebRotate injects .wr360_player; keep it transparent and full-size. */
  .tt .wr360_player {
    background: transparent !important;
  }

  .tt__loading {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    transition: opacity 0.4s;
  }

  .tt__loading span {
    display: block;
    height: 100%;
    width: var(--progress, 0%);
    background: var(--accent);
    transition: width 0.2s linear;
  }

  .tt.is-ready .tt__loading {
    opacity: 0;
  }

  .tt__locked {
    display: none;
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 6;
    margin: 0;
    padding: 10px 14px;
    border-radius: 4px;
    background: rgba(18, 18, 15, 0.82);
    color: var(--room-ink);
    font-size: 13px;
    line-height: 1.45;
  }

  .tt.is-locked .tt__locked {
    display: block;
  }

  .tt.is-locked .tt__loading,
  .tt.is-locked .tt__hint {
    visibility: hidden;
  }

  .tt.is-locked .tt__viewer {
    cursor: default;
  }

  .tt__step:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .tt__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 5;
    pointer-events: none;
  }

  .tt__hud {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 16px;
  }

  .tt__step:hover {
    background: var(--room-ink);
    color: var(--room);
  }

  .tt__dial {
    display: flex;
    align-items: center;
    gap: 10px;
    font-variant-numeric: tabular-nums;
  }

  .tt__dial svg {
    width: 34px;
    height: 34px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    opacity: 0.8;
  }

  .tt__needle {
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    transform-origin: 20px 20px;
    transform: rotate(var(--deg, 0deg));
  }

  .tt__deg {
    min-width: 4ch;
    font-size: 13px;
    font-weight: 600;
  }

  .tt__hint {
    flex: 1;
    margin: 0;
    color: var(--room-muted);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tt__hint::before,
  .tt__hint::after {
    content: '';
    flex: 0 1 48px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }

  .tt__spots {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .tt__spots button {
    width: 100%;
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 18px 0;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    background: none;
    text-align: left;
    font-size: 15px;
    transition: color 0.2s, padding 0.3s var(--ease);
  }

  .tt__spots button:hover {
    color: var(--accent);
    padding-left: 6px;
  }

  .tt__spot-no {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--accent);
  }

  @media (min-width: 761px) {
    .tt__spots li:not(:last-child) button {
      margin-right: 24px;
    }
    .tt__spots li {
      padding-right: 24px;
    }
  }

  @media (max-width: 520px) {
    .tt__hint::before,
    .tt__hint::after {
      display: none;
    }
    .tt__hud {
      gap: 10px;
    }
  }
</style>

<script>
  import '../scripts/turntable.js';
</script>
