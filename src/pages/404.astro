---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { url } from '../data/site.js';
---

<Base title="Halaman tidak ditemukan">
  <Header variant="type" />
  <main class="nf wrap">
    <h1 class="display nf__title">Halaman tidak ditemukan</h1>
    <p class="nf__text">Alamat ini tidak ada atau sudah dipindahkan.</p>
    <a class="btn btn--solid" href={url('/')}>Kembali ke beranda</a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 20px;
    padding-top: var(--header-h);
  }

  .nf__title {
    margin: 0;
    font-size: clamp(48px, 8vw, 112px);
  }

  .nf__text {
    margin: 0;
    color: var(--ink-2);
  }
</style>
