---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { labels, url } from '../data/site.js';
---

<Base title={labels.notFound.title}>
  <Header variant="type" />
  <main class="nf wrap">
    <h1 class="display nf__title">{labels.notFound.title}</h1>
    <p class="nf__text">{labels.notFound.text}</p>
    <a class="btn btn--solid" href={url('/')}>{labels.notFound.button}</a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 20px;
    padding-top: var(--header-h);
  }

  .nf__title {
    margin: 0;
    font-size: clamp(48px, 8vw, 112px);
  }

  .nf__text {
    margin: 0;
    color: var(--ink-2);
  }
</style>
