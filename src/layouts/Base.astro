---
import '../styles/global.css';
import Overlay from '../components/Overlay.astro';
import { site, url } from '../data/site.js';

interface Props {
  title?: string;
  // Full <title>, used as is (a type's SEO title).
  fullTitle?: string;
  description?: string;
  bodyClass?: string;
}

const { title, fullTitle, description = site.description, bodyClass = '' } = Astro.props;
const pageTitle = fullTitle || (title ? `${title} — ${site.fullName}` : site.fullName);

const shareImage = site.shareImage && new URL(url(site.shareImage.src), Astro.site ?? Astro.url).href;
// CMS colours override the defaults in global.css.
const gtag =
  site.analyticsId &&
  `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',${JSON.stringify(site.analyticsId)});`;
const theme = `--accent: ${site.theme.accent}; --sold: ${site.theme.sold}; --reserved: ${site.theme.reserved}; --available: ${site.theme.available};`;
---

<!doctype html>
<html lang={site.lang} class="no-js" style={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.fullName} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="theme-color" content="#0b0d0f" />
    <link rel="icon" href={site.faviconHref} />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    {site.analyticsId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.analyticsId}`} />}
    {site.analyticsId && <script is:inline set:html={gtag} />}
  </head>
  <body class={bodyClass}>
    <slot />
    <Overlay />
    <script>
      import '../scripts/reveal.js';
      import '../scripts/overlay.js';
    </script>
  </body>
</html>
